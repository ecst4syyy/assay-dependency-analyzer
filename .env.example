# Copy to .env and replace every value. .env is gitignored.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
SECRET_KEY=change-me-to-48-random-bytes-from-secrets-token-urlsafe
JWT_SECRET_KEY=change-me-to-a-different-48-random-bytes-value

# MySQL. The app connects as a least-privilege user; migrations run as a
# separate user. The root password is only used by the MySQL container.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=assay
MYSQL_APP_USER=assay_app
MYSQL_APP_PASSWORD=change-me-app
MYSQL_MIGRATE_USER=assay_migrate
MYSQL_MIGRATE_PASSWORD=change-me-migrate

# Outbound User-Agent contact URL.
REPO_URL=https://github.com/your-account/assay

# Local demo over plain HTTP on 127.0.0.1. Set FORCE_HTTPS=true behind TLS.
FORCE_HTTPS=false
SESSION_COOKIE_SECURE=true
